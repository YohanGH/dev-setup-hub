{
  "$comment": "Configuration Claude Code de dev-setup-hub. Voir CLAUDE.md pour les conventions du depot.",

  "includeCoAuthoredBy": false,

  "permissions": {
    "$comment": "Ce depot vit de commandes en lecture seule repetees. Les autoriser supprime l'essentiel des interruptions sans ouvrir quoi que ce soit d'ecrivable.",

    "allow": [
      "Read(./**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(bash -n:*)",
      "Bash(shellcheck:*)",
      "Bash(shfmt:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(du:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(./install.sh --list)",
      "Bash(./install.sh --help)",
      "Bash(./install/99-summary.sh)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-repo:*)",
      "Bash(brew install:*)",
      "Bash(apt-get:*)",
      "Bash(sudo:*)"
    ],

    "denyComment": "Exactement ce qu'on a sorti du depot pour qu'il n'y soit pas.",

    "deny": [
      "Read(~/.zsh_local)",
      "Read(~/.config/dev-setup-hub/identity)",
      "Read(./**/*.kdbx)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-shell.sh",
            "statusMessage": "verification shell avant commit",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
