root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true


# Les scripts shell sont indentes par TABULATIONS : c'est ce qu'utilisent tous
# les scripts du depot, c'est le defaut de shfmt, et c'est ce que la CI verifie.
[*.sh]
indent_style = tab

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
