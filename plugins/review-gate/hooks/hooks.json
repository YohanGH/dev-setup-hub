{
  "$comment": "Plugin hooks. Same schema as the `hooks` object in settings.json. ${CLAUDE_PLUGIN_ROOT} resolves to this plugin's directory wherever it is installed — never hardcode a path here.",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh commit",
            "statusMessage": "review-gate: checking commit",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh write",
            "timeout": 15
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh stop",
            "statusMessage": "review-gate",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
