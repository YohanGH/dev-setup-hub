{
  "$comment": "Personal overrides. Copy to .claude/settings.local.json — it is gitignored. Nothing here is shared with the team.",

  "claudeMdExcludes": [
    "**/packages/legacy-*/**",
    "**/apps/admin-dashboard/**"
  ],

  "env": {
    "$comment": "off | warn | block — how the Stop hook reacts to a failing quality gate.",
    "CLAUDE_QUALITY_GATE": "block",
    "$comment2": "changed | all — how much the preflight battery runs.",
    "CLAUDE_PREFLIGHT_SCOPE": "changed",
    "$comment3": "Where tickets are fetched from: gh | jira | none.",
    "CLAUDE_TICKET_SOURCE": "gh"
  },

  "permissions": {
    "additionalDirectories": [
      "../shared-design-system"
    ]
  }
}
